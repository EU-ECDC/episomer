      "type": "text",
      "x": 326.8299331665039,
      "y": 3271.4166666666656,
      "width": 1885.37890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
