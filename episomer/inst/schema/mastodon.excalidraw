      "index": "b0C",
      "roundness": null,
      "seed": 626924972,
      "version": 216,
      "versionNonce": 636384660,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784901348336,
      "link": null,
      "locked": false,
      "text": "la suppression de messages par rapport à l'id de référence est donc une erreur !!",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "la suppression de messages par rapport à l'id de référence est donc une erreur !!",
