    },
    {
      "id": "text0148",
      "type": "text",
      "x": 92,
      "y": 2382.75,
      "width": 797.8800000000001,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2N",
      "roundness": null,
      "seed": 1396152108,
      "version": 1,
      "versionNonce": 435181256,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "Trop COURT  → fausses expirations : un runner occupé mais vivant se fait voler sa place → deux collecteurs → doublons.\nTrop LONG   → seule la bascule est plus lente. Aucun risque de corruption.\n→ Se tromper « trop long » est le sens sûr. Le TTL n'est pas un bouton de performance.\nLe battement (runner_heartbeat_span, 30 s) doit rester ~10× plus court que le plus court TTL :\nquelques renouvellements perdus d'affilée (fs lent, réseau qui hoquette) ne doivent pas suffire à expirer un lease vivant.",
      "originalText": "Trop COURT  → fausses expirations : un runner occupé mais vivant se fait voler sa place → deux collecteurs → doublons.\nTrop LONG   → seule la bascule est plus lente. Aucun risque de corruption.\n→ Se tromper « trop long » est le sens sûr. Le TTL n'est pas un bouton de performance.\nLe battement (runner_heartbeat_span, 30 s) doit rester ~10× plus court que le plus court TTL :\nquelques renouvellements perdus d'affilée (fs lent, réseau qui hoquette) ne doivent pas suffire à expirer un lease vivant.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
