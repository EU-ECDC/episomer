    {
      "id": "text078",
      "type": "text",
      "x": 114.79999999999998,
      "y": 955.75,
      "width": 400.40000000000003,
      "height": 122.5,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
