    {
      "id": "hbx04",
      "type": "text",
      "x": 90,
      "y": 2335.0,
      "width": 420,
      "height": 70.0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "roundness": null,
      "text": "sleep_with_heartbeat(seconds)\n« je ne vais rien faire pendant un moment »\ndécoupe l'attente en tranches de runner_heartbeat_span\nentre deux tranches : renew + stop_if_lease_lost",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "hbr03",
      "originalText": "sleep_with_heartbeat(seconds)\n« je ne vais rien faire pendant un moment »\ndécoupe l'attente en tranches de runner_heartbeat_span\nentre deux tranches : renew + stop_if_lease_lost",
      "autoResize": true,
      "lineHeight": 1.25,
