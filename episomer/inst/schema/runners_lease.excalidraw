    },
    {
      "id": "text0494",
      "type": "text",
      "x": 292,
      "y": 9123.25,
      "width": 686.7,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7x",
