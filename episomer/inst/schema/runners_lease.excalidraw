    {
      "id": "text0516",
      "type": "text",
      "x": 92,
      "y": 9711.5,
      "width": 595.1400000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
