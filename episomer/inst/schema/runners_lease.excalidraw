    {
      "id": "text0024",
      "type": "text",
      "x": 92,
      "y": 557.75,
      "width": 510.12000000000006,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0N",
      "roundness": null,
      "seed": 1306298652,
      "version": 1,
      "versionNonce": 238882063,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "B et C demandent les mêmes posts à la même API, et les écrivent tous les deux.\n→ comptages doublés → seuils de détection faux → alertes fausses.\n→ et, pour detect : deux fois les mêmes courriels envoyés aux abonnés,\n   ce qu'aucune déduplication côté base ne peut rattraper.",
      "originalText": "B et C demandent les mêmes posts à la même API, et les écrivent tous les deux.\n→ comptages doublés → seuils de détection faux → alertes fausses.\n→ et, pour detect : deux fois les mêmes courriels envoyés aux abonnés,\n   ce qu'aucune déduplication côté base ne peut rattraper.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
