      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "Ce qui INFORME seulement",
      "originalText": "Ce qui INFORME seulement",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text0093",
      "type": "text",
      "x": 1532,
      "y": 1712.5,
      "width": 392.40000000000003,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1U",
      "roundness": null,
      "seed": 2108431790,
      "version": 1,
      "versionNonce": 547096239,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "claimed_at        depuis quand cette instance est titulaire\nrenewed_at        l'heure du claim, PAS du dernier battement\npid               diagnostic, sauf le cas host+pid ci-contre\nhost              affiché partout : « running on host … »\nepisomer_version  utile quand deux machines n'ont pas\n                  la même version installée\nrunner / service  redondants avec le nom du fichier,\n                  mais ils rendent le fichier lisible seul",
      "originalText": "claimed_at        depuis quand cette instance est titulaire\nrenewed_at        l'heure du claim, PAS du dernier battement\npid               diagnostic, sauf le cas host+pid ci-contre\nhost              affiché partout : « running on host … »\nepisomer_version  utile quand deux machines n'ont pas\n                  la même version installée\nrunner / service  redondants avec le nom du fichier,\n                  mais ils rendent le fichier lisible seul",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rect0094",
