      "roundness": null,
      "seed": 1668428901,
      "version": 1,
      "versionNonce": 834143958,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "runner_lease_ttl(name) prend le service (la partie avant le premier point) et cherche conf$runner_ttl_<service>, sinon runner_lease_ttl_defaults(), sinon 300 s.",
