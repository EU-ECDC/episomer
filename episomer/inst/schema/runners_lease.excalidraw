      "width": 1380,
      "height": 92.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffeded",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1Y",
      "roundness": {
        "type": 3
      },
