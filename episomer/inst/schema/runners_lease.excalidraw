      "link": null,
      "locked": false
    },
    {
      "id": "text0231",
      "type": "text",
      "x": 1812,
      "y": 3442.25,
      "width": 198.38000000000002,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
