    },
    {
      "id": "text0437",
      "type": "text",
      "x": 80,
      "y": 7266.0,
      "width": 828.945,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
