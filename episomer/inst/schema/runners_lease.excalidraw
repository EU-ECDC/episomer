      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "text": "Les points de garde — là où perdre son lease abîmerait vraiment quelque chose",
      "originalText": "Les points de garde — là où perdre son lease abîmerait vraiment quelque chose"
    },
