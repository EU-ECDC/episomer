    },
    {
      "id": "text0027",
      "type": "text",
      "x": 852,
      "y": 557.75,
      "width": 523.2,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0Q",
      "roundness": null,
      "seed": 241595097,
      "version": 1,
      "versionNonce": 1297291882,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "Un seul des deux collecte. L'autre lit un petit fichier JSON, comprend que la\nplace est prise, et attend en réessayant.\nQuand le premier s'arrête (ou disparaît), le second prend le relais tout seul.\nC'est tout le mécanisme : un fichier, une date de dernière modification, un TTL.",
      "originalText": "Un seul des deux collecte. L'autre lit un petit fichier JSON, comprend que la\nplace est prise, et attend en réessayant.\nQuand le premier s'arrête (ou disparaît), le second prend le relais tout seul.\nC'est tout le mécanisme : un fichier, une date de dernière modification, un TTL.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rect0028",
      "type": "rectangle",
      "x": 1600,
      "y": 204.25,
      "width": 940,
      "height": 212.5,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0R",
      "roundness": {
        "type": 3
      },
