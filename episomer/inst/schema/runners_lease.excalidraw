      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "12 · « Est-ce que ça tourne ? » — deux questions, ne jamais les confondre",
      "originalText": "12 · « Est-ce que ça tourne ? » — deux questions, ne jamais les confondre",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
