      "text": "Question CLUSTER — « quelqu'un, quelque part, fait-il ce travail ? »",
      "originalText": "Question CLUSTER — « quelqu'un, quelque part, fait-il ce travail ? »",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
