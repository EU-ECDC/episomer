    {
      "id": "text0181",
      "type": "text",
      "x": 652,
      "y": 3022.0,
      "width": 503.58000000000004,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
