      "versionNonce": 913311739,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "Ce qui DÉCIDE",
      "originalText": "Ce qui DÉCIDE",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text0090",
      "type": "text",
      "x": 852,
      "y": 1712.5,
      "width": 359.70000000000005,
      "height": 165.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1R",
      "roundness": null,
      "seed": 1658582218,
      "version": 1,
      "versionNonce": 790874606,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "mtime du fichier   → lease$seen_at\n     lu par epifile.mtime(), produit par la machine fs.\n     C'est la fraîcheur : age = now - seen_at.\n\ninstance_id\n     « est-ce toujours moi ? » — i_hold_runner_lease(),\n     stop_if_lease_lost(), lease_is_free().\n\nhost + pid  (ensemble seulement)\n     le raccourci « ce titulaire a planté ICI »\n     (panneau 7).",
      "originalText": "mtime du fichier   → lease$seen_at\n     lu par epifile.mtime(), produit par la machine fs.\n     C'est la fraîcheur : age = now - seen_at.\n\ninstance_id\n     « est-ce toujours moi ? » — i_hold_runner_lease(),\n     stop_if_lease_lost(), lease_is_free().\n\nhost + pid  (ensemble seulement)\n     le raccourci « ce titulaire a planté ICI »\n     (panneau 7).",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rect0091",
