      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "11 · Rendre sa place — release_runner_lease() et unregister_runner()",
      "originalText": "11 · Rendre sa place — release_runner_lease() et unregister_runner()",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
