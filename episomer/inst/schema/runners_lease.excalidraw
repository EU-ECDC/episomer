      "locked": false
    },
    {
      "id": "text0464",
      "type": "text",
      "x": 792,
      "y": 7770.5,
      "width": 129.71,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
