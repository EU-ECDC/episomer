      "index": "a1e",
      "roundness": null,
      "seed": 475167381,
      "version": 1,
      "versionNonce": 470527174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "4 · Les runners qui existent, et leur TTL",
      "originalText": "4 · Les runners qui existent, et leur TTL",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text0104",
      "type": "text",
      "x": 80,
      "y": 2135.0,
      "width": 1133.6000000000001,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
