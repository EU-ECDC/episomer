    },
    {
      "id": "text0098",
      "type": "text",
      "x": 92,
      "y": 1989.0,
      "width": 427.28000000000003,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
