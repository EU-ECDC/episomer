    {
      "id": "hbx06",
      "type": "text",
      "x": 570,
      "y": 2335.0,
      "width": 420,
      "height": 70.0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "roundness": null,
      "text": "renew_runner_lease_if_due()\n« je suis occupé mais je repasse souvent »\nun touch au plus par runner_heartbeat_span\n(lease_last_renewal : mémoire locale du process)",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "hbr05",
      "originalText": "renew_runner_lease_if_due()\n« je suis occupé mais je repasse souvent »\nun touch au plus par runner_heartbeat_span\n(lease_last_renewal : mémoire locale du process)",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
