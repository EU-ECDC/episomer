    {
      "id": "run8_x0",
      "x": 80,
      "y": 4672,
      "width": 977.9000000000001,
      "height": 35.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
