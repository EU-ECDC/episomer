      "version": 1,
      "versionNonce": 433219232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "runner_service(\"search.mastodon.piaille.fr\") → \"search\"\n\n  fs        heartbeat 30 s     ttl  120 s\n  search    heartbeat 30 s     ttl  300 s\n  detect    heartbeat 30 s     ttl 1800 s\n\nconf$runner_ttl_<service> d'abord, sinon les défauts.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect077",
      "originalText": "runner_service(\"search.mastodon.piaille.fr\") → \"search\"\n\n  fs        heartbeat 30 s     ttl  120 s\n  search    heartbeat 30 s     ttl  300 s\n  detect    heartbeat 30 s     ttl 1800 s\n\nconf$runner_ttl_<service> d'abord, sinon les défauts.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text079",
      "type": "text",
      "x": 80,
      "y": 1112,
      "width": 429.52,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
