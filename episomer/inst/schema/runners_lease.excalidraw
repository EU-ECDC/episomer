      "link": null,
      "locked": false
    },
    {
      "id": "text0292",
      "type": "text",
      "x": 1332,
      "y": 5240.25,
      "width": 419.65000000000003,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
