      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "read_runner_lease(name)\n  → NULL, ou le contenu + seen_at (la mtime)\n  → lit le CONTENU AVANT la mtime : l'ordre inverse\n     laisserait croire qu'un titulaire tout juste arrivé\n     est périmé, et on lui volerait son lease.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "read_runner_lease(name)\n  → NULL, ou le contenu + seen_at (la mtime)\n  → lit le CONTENU AVANT la mtime : l'ordre inverse\n     laisserait croire qu'un titulaire tout juste arrivé\n     est périmé, et on lui volerait son lease.",
      "autoResize": true,
      "lineHeight": 1.25
    },
