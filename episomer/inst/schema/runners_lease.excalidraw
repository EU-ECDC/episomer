    },
    {
      "id": "text0444",
      "type": "text",
      "x": 1332,
      "y": 7343.75,
      "width": 542.82,
      "height": 300.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
