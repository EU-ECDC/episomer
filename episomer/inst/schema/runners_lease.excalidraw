      "seed": 1604287059,
      "version": 1,
      "versionNonce": 160843992,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "Un TTL long n'est pas un problème de correction : il ne\nralentit que la reprise. La correction vient du guard.\n\nrunner_lease_status(name) → free | running | stale\n(lecture seule : l'app Shiny et is_*_running(), issues 7-8)",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un TTL long n'est pas un problème de correction : il ne\nralentit que la reprise. La correction vient du guard.\n\nrunner_lease_status(name) → free | running | stale\n(lecture seule : l'app Shiny et is_*_running(), issues 7-8)",
      "autoResize": true,
      "lineHeight": 1.25
    },
