      "locked": false
    },
    {
      "id": "text0095",
      "type": "text",
      "x": 2212,
      "y": 1689.0,
      "width": 129.71,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
