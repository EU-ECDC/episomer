      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "7 · « La place est-elle libre ? » — lease_is_free(lease, name)",
      "originalText": "7 · « La place est-elle libre ? » — lease_is_free(lease, name)",
