    },
    {
      "id": "hbr07",
      "type": "rectangle",
      "x": 1040,
      "y": 2320,
      "width": 470,
      "height": 100,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "roundness": {
        "type": 3
      },
      "boundElements": [
        {
          "type": "text",
          "id": "hbx08"
        }
      ],
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1z",
      "seed": 1829492907,
      "version": 1,
      "versionNonce": 175649215,
      "isDeleted": false,
      "updated": 1787905195780,
      "link": null,
      "locked": false
    },
    {
      "id": "hbx08",
      "type": "text",
      "x": 1050,
      "y": 2335.0,
      "width": 450,
      "height": 70.0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "roundness": null,
      "text": "Surtout pas un process de fond (future)\nun batteur en tâche de fond crie « vivant » pendant que la\nboucle est bloquée — c'est justement la panne que le lease\ndoit révéler. Ici on ne bat que si la boucle atteint la ligne.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "hbr07",
      "originalText": "Surtout pas un process de fond (future)\nun batteur en tâche de fond crie « vivant » pendant que la\nboucle est bloquée — c'est justement la panne que le lease\ndoit révéler. Ici on ne bat que si la boucle atteint la ligne.",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
