      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "renew_runner_lease() vérifie l'existence avant de toucher :\nepifile.touch() CRÉE le fichier manquant, et un lease vide\nnon-JSON polluerait le listing lu par le tableau Shiny.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "renew_runner_lease() vérifie l'existence avant de toucher :\nepifile.touch() CRÉE le fichier manquant, et un lease vide\nnon-JSON polluerait le listing lu par le tableau Shiny.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text076",
      "type": "text",
      "x": 80,
      "y": 900,
      "width": 457.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
