      "boundElements": [],
      "updated": 1787905195780,
      "link": null,
      "locked": false,
      "text": "B : on.exit → unregister_runner() → le fichier part vers runners/old/, le PID est retiré.\nC : à sa tentative suivante, read → absent → LIBRE → write + 5 s de guard + relecture\n    → c'est bien mon instance_id → TRUE → C collecte.\nBascule : quelques secondes.",
      "originalText": "B : on.exit → unregister_runner() → le fichier part vers runners/old/, le PID est retiré.\nC : à sa tentative suivante, read → absent → LIBRE → write + 5 s de guard + relecture\n    → c'est bien mon instance_id → TRUE → C collecte.\nBascule : quelques secondes.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
