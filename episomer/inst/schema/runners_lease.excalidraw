      "link": null,
      "locked": false,
      "text": "on.exit(release_runner_lease())\nfs_loop(), search_loop(), search_loop_worker(),\ndetect_loop()\n→ panneau 3 : le successeur démarre sans\n   attendre l'expiration du TTL",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect119",
      "originalText": "on.exit(release_runner_lease())\nfs_loop(), search_loop(), search_loop_worker(),\ndetect_loop()\n→ panneau 3 : le successeur démarre sans\n   attendre l'expiration du TTL",
      "autoResize": true,
      "lineHeight": 1.25
    },
