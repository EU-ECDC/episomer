      "width": 1020,
      "height": 107.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffeded",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
